/**
 * Regression tests for hostile-UI breaks found in learning-records/hostile-ui/.
 * These tests intentionally FAIL on today's product — accusation, not defense.
 */
import assert from "node:assert/strict";
import { readFile } from "node:fs/promises";
import { test } from "node:test";
import path from "node:path";
import { fileURLToPath } from "node:url";
import vm from "node:vm";
import { chromium } from "playwright";

const gameDirectory = path.dirname(fileURLToPath(import.meta.url));
const repositoryRoot = path.dirname(gameDirectory);
const rulesPath = path.join(gameDirectory, "run-champion-bomb-duel.js");
const startPath = path.join(gameDirectory, "start-champion-duel.js");
const BASE = process.env.RIFTBOMB_URL || "http://127.0.0.1:4177/riftbomb.html";

async function loadGameClass() {
  const rules = await readFile(rulesPath, "utf8");
  const context = vm.createContext({
    console,
    Math,
    Object,
    Array,
    Map,
    Set,
    String,
    Number,
    Boolean,
    parseInt,
    parseFloat,
    isNaN,
    Infinity,
    innerWidth: 1280,
    innerHeight: 720,
  });
  vm.runInContext(
    `
    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
    const TAU = Math.PI * 2;
    const Renderer = {
      colors: {
        blueSide: [0, 0, 1], redSide: [1, 0, 0], ice: [1, 1, 1], ember: [1, 0.5, 0],
        rift: [0, 1, 1], katCrimson: [1, 0, 0], zedCrimson: [1, 0, 0], zedShadow: [0.2, 0, 0.2],
        renektonGold: [1, 0.8, 0], vladimirCrimson: [0.8, 0, 0.2],
      },
    };
    ${rules}
    globalThis.Game = Game;
  `,
    context
  );
  return context.Game;
}

function makeMatch(Game) {
  const presentation = {
    selectChampion() {},
    prepareRound() {},
    announce() {},
    update() {},
    finish() {},
    setPaused() {},
  };
  const music = { effect() {}, explosion() {}, togglePause() {} };
  const renderer = { cameraShake: 0, hitPulse: 0, addShock() {} };
  return new Game(renderer, music, presentation);
}

test("BREAK grace-window-steals-first-kill-win: first elimination must keep the round even if killer dies before lock", async () => {
  const Game = await loadGameClass();
  const match = makeMatch(Game);
  match.start();
  match.update(1.3); // burn spawn invulnerability
  const p1 = match.players[0];
  const p2 = match.players[1];
  p1.invulnerable = 0;
  p2.invulnerable = 0;

  // P1 eliminates P2 first — product promise: P1 wins the round.
  assert.equal(match.hitSkill(p2, 1, p1, "FirstBlood"), true);
  assert.equal(p2.alive, false);
  assert.ok(match.roundDecisionTimer >= 0, "grace timer should arm after a kill");

  // Within the 0.16s grace, P1 also dies (pre-placed bomb, revenge, etc.).
  p1.invulnerable = 0;
  assert.equal(match.hitSkill(p1, 1, p2, "Revenge"), true);
  assert.equal(p1.alive, false);

  match.update(0.25);

  // FAILS TODAY: finalizeRound only looks at who is still alive → draw, score 0-0.
  // Correct: first decisive elimination (P1) should own the round → wins [1, 0].
  assert.deepEqual(
    match.roundWins,
    [1, 0],
    "first kill must not be erased when the killer dies inside the round-decision grace window"
  );
});

test("BREAK start-stays-armed-after-play: Start must remain disabled after the match begins", async () => {
  // Source-level accusation matching the UI hazard:
  // beginGame re-enables #start-game after game.start(), so Space/Enter can re-fire beginGame
  // if focus ever returns to that control.
  const boot = await readFile(startPath, "utf8");
  const reenables = /UI\.start\.disabled\s*=\s*false/.test(boot);
  const startsMatch = /game\.start\(\)/.test(boot);

  assert.equal(startsMatch, true);
  // FAILS TODAY: beginGame sets disabled=false after starting the match.
  assert.equal(
    reenables,
    false,
    "start-champion-duel.js must not re-enable #start-game after game.start() — that leaves a destructive control armed mid-match"
  );
});

test("BREAK input-storm-must-not-hang-or-crash: keyboard storm must leave the arena responsive", async (t) => {
  let browser;
  try {
    browser = await chromium.launch({
      headless: true,
      args: ["--disable-dev-shm-usage", "--use-gl=swiftshader"],
    });
  } catch (error) {
    t.skip(`playwright chromium unavailable: ${error.message}`);
    return;
  }

  const context = await browser.newContext({ viewport: { width: 1280, height: 720 } });
  const page = await context.newPage();
  let crashed = false;
  page.on("crash", () => {
    crashed = true;
  });

  try {
    await page.goto(BASE, { waitUntil: "domcontentloaded", timeout: 30000 });
    await page.click("#start-game");
    await page.waitForFunction(() => document.getElementById("intro")?.classList.contains("is-gone"), null, {
      timeout: 15000,
    });

    const timerBefore = await page.locator("#enemy-count").innerText();

    // Same class of storm that produced page-crash / hang videos in learning-records/hostile-ui/breaks/
    const storm = (async () => {
      for (let i = 0; i < 40; i++) {
        await page.keyboard.press("Space");
        await page.keyboard.press("KeyQ");
        await page.keyboard.press("KeyF");
        await page.keyboard.press("KeyE");
        await page.keyboard.press("KeyR");
        await page.keyboard.press("KeyW");
        await page.keyboard.press("KeyA");
        await page.keyboard.press("ArrowDown");
        await page.keyboard.press("Enter");
      }
    })();

    // FAILS TODAY when the tab crashes or the storm never settles within the budget.
    await Promise.race([
      storm,
      new Promise((_, reject) => setTimeout(() => reject(new Error("input-storm hung > 20s")), 20000)),
    ]);

    assert.equal(crashed, false, "page must not crash under keyboard input storm");

    await page.waitForTimeout(1200);
    const timerAfter = await page.locator("#enemy-count").innerText();
    const pause = await page.locator("#pause-toggle").getAttribute("aria-pressed");
    const endHidden = await page.locator("#end-screen").evaluate((el) => el.hidden);

    if (pause !== "true" && endHidden) {
      assert.ok(
        Number(timerAfter) < Number(timerBefore),
        "round timer must keep advancing after an input storm (silent freeze is a break)"
      );
    }
  } finally {
    await context.close().catch(() => {});
    await browser.close().catch(() => {});
  }
});
