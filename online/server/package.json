{
  "name": "riftbomb-authoritative-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "benchmark:room-clock": "node scripts/benchmark-room-clock.mjs",
    "benchmark:grid-cache": "node scripts/benchmark-grid-cache.mjs",
    "benchmark:message-rate-limit": "node scripts/benchmark-message-rate-limit.mjs",
    "benchmark:telemetry": "node scripts/benchmark-telemetry-overhead.mjs",
    "start": "node src/server.mjs",
    "benchmark:boot": "node scripts/benchmark-server-boot.mjs",
    "benchmark:serialization": "node scripts/benchmark-json-transport.mjs",
    "test": "npm run test:core && npm run test:runtime-loading && npm run test:serialization && npm run test:rate-limit && npm run test:transport && npm run test:rematch",
    "test:core": "node --test tests/authoritative-core.test.mjs",
    "test:runtime-loading": "node --test tests/authoritative-runtime-loading.test.mjs",
    "test:serialization": "node --test tests/json-transport.test.mjs",
    "test:rate-limit": "node --test tests/message-rate-limit.test.mjs",
    "test:transport": "node --test --test-name-pattern=websocket tests/authoritative-server.test.mjs",
    "test:rematch": "node --test --test-name-pattern=rematch tests/authoritative-server.test.mjs"
  },
  "dependencies": {
    "ws": "8.21.1"
  }
}
