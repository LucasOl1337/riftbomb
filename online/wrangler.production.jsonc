{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riftbomb-online",
  "account_id": "f838f7d26348a09f88fb38ea03272857",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "no_bundle": true,
  "workers_dev": true,
  "preview_urls": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riftbomb-online",
      "database_id": "0d1c4351-7070-4d8f-8035-d5e1ae291a61"
    }
  ],
  "vars": {
    "GAME_SERVER_ORIGIN": "https://aurora.simple-ai.cc/riftbomb-ws"
  },
  "routes": [
    {
      "pattern": "bombpvp.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
